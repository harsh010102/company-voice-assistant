# Copy to .env.local for local dev, or set these in Vercel → Project → Settings → Environment Variables.

# REQUIRED — Google Gemini (primary model). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OPTIONAL — automatic fallbacks if Gemini is rate-limited / unavailable.
# OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# NVIDIA NIM: https://build.nvidia.com/
NVIDIA_API_KEY=
